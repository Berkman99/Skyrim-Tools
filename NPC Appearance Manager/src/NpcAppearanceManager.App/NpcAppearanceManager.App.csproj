<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>NpcAppearanceManager.App</RootNamespace>
    <AssemblyName>NPC Appearance Manager</AssemblyName>
    <Version>1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>NPC Appearance Manager</Product>
    <Company>NPC Appearance Manager</Company>
    <!-- The tool is English only: no .NET translation folders. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No .pdb files next to the exe in a release. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- MO2 hooks launched programs (USVFS). With Windows' CET shadow stack enabled the process crashes at
         start-up under MO2, so the exe is marked as not CET-compatible (same fix NPC2 uses). -->
    <CETCompat>false</CETCompat>
    <!-- The logo: on the exe, and (as a resource) on the window and taskbar. -->
    <ApplicationIcon>NAM.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF projects don't get System.IO as an implicit using. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="NAM.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NpcAppearanceManager.Core\NpcAppearanceManager.Core.csproj" />
  </ItemGroup>

  <!-- Internal renderer: NPC Plugin Chooser 2's offscreen 3D renderer (CharacterViewer.Rendering), with the
       libraries it needs, copied from NPC2 into lib\Renderer so the build doesn't need NPC2 installed.
       Without it the app still builds; the "Internal renderer" option just shows as unavailable. -->
  <PropertyGroup>
    <RendererFolder Condition="'$(RendererFolder)' == ''">$(MSBuildThisFileDirectory)..\..\lib\Renderer</RendererFolder>
    <HasInternalRenderer Condition="Exists('$(RendererFolder)\CharacterViewer.Rendering.dll')">true</HasInternalRenderer>
    <DefineConstants Condition="'$(HasInternalRenderer)' == 'true'">$(DefineConstants);INTERNAL_RENDERER</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(HasInternalRenderer)' == 'true'">
    <Reference Include="CharacterViewer.Rendering"><HintPath>$(RendererFolder)\CharacterViewer.Rendering.dll</HintPath></Reference>
    <Reference Include="OpenTK.Core"><HintPath>$(RendererFolder)\OpenTK.Core.dll</HintPath></Reference>
    <Reference Include="OpenTK.Mathematics"><HintPath>$(RendererFolder)\OpenTK.Mathematics.dll</HintPath></Reference>
    <Reference Include="OpenTK.Graphics"><HintPath>$(RendererFolder)\OpenTK.Graphics.dll</HintPath></Reference>
    <Reference Include="OpenTK.Windowing.Common"><HintPath>$(RendererFolder)\OpenTK.Windowing.Common.dll</HintPath></Reference>
    <Reference Include="OpenTK.Windowing.Desktop"><HintPath>$(RendererFolder)\OpenTK.Windowing.Desktop.dll</HintPath></Reference>
    <Reference Include="OpenTK.Windowing.GraphicsLibraryFramework"><HintPath>$(RendererFolder)\OpenTK.Windowing.GraphicsLibraryFramework.dll</HintPath></Reference>
    <Reference Include="OpenTK.Input"><HintPath>$(RendererFolder)\OpenTK.Input.dll</HintPath></Reference>
    <Reference Include="OpenTK.Compute"><HintPath>$(RendererFolder)\OpenTK.Compute.dll</HintPath></Reference>
    <Reference Include="Pfim"><HintPath>$(RendererFolder)\Pfim.dll</HintPath></Reference>
    <Reference Include="ReactiveUI"><HintPath>$(RendererFolder)\ReactiveUI.dll</HintPath></Reference>
    <Reference Include="ReactiveUI.Wpf"><HintPath>$(RendererFolder)\ReactiveUI.Wpf.dll</HintPath></Reference>
    <Reference Include="System.Reactive"><HintPath>$(RendererFolder)\System.Reactive.dll</HintPath></Reference>
    <Reference Include="DynamicData"><HintPath>$(RendererFolder)\DynamicData.dll</HintPath></Reference>
    <Reference Include="Splat"><HintPath>$(RendererFolder)\Splat.dll</HintPath></Reference>
    <Reference Include="Splat.Core"><HintPath>$(RendererFolder)\Splat.Core.dll</HintPath></Reference>
    <Reference Include="Splat.Logging"><HintPath>$(RendererFolder)\Splat.Logging.dll</HintPath></Reference>
    <Reference Include="Splat.Builder"><HintPath>$(RendererFolder)\Splat.Builder.dll</HintPath></Reference>
    <Reference Include="SixLabors.ImageSharp"><HintPath>$(RendererFolder)\SixLabors.ImageSharp.dll</HintPath></Reference>
    <None Include="$(RendererFolder)\runtimes\win-x64\native\glfw3.dll" Condition="Exists('$(RendererFolder)\runtimes\win-x64\native\glfw3.dll')"
          Link="runtimes\win-x64\native\glfw3.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(RendererFolder)\runtimes\win-x64\native\glfw3.dll" Condition="Exists('$(RendererFolder)\runtimes\win-x64\native\glfw3.dll')"
          Link="glfw3.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(RendererFolder)\Shaders\**\*" Link="Shaders\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- NPC Portrait Creator (NPC2's older renderer, a program of its own), shipped in its own folder next to the exe. -->
  <ItemGroup>
    <None Include="..\..\lib\NPC Portrait Creator\**\*" Link="NPC Portrait Creator\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
