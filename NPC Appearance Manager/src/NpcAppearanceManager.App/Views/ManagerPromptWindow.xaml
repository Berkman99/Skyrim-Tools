<Window x:Class="NpcAppearanceManager.App.Views.ManagerPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Mod Manager" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- One of the three choices: highlighted in amber when picked -->
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="4" Padding="12,9" BorderThickness="1"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Which mod manager do you use for Skyrim?" Margin="0,0,0,14" />
        <RadioButton x:Name="Mo2" Content="Mod Organizer 2" Style="{StaticResource Choice}" />
        <RadioButton x:Name="VortexChoice" Content="Vortex" Style="{StaticResource Choice}" />
        <RadioButton x:Name="NoManager" Content="No manager" Style="{StaticResource Choice}" />
        <TextBlock Text="You can change this later in Settings." Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
        <Button Content="OK" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="22,6" Margin="0,14,0,0"
                IsDefault="True" Click="Confirm" />
    </StackPanel>
</Window>
