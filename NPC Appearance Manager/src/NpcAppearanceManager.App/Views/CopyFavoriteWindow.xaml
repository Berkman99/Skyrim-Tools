<Window x:Class="NpcAppearanceManager.App.Views.CopyFavoriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy face" SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="Question" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14" />
        <StackPanel Orientation="Horizontal">
            <Border Width="96" Height="96" CornerRadius="6" Background="{StaticResource PictureBackBrush}" ClipToBounds="True">
                <Image x:Name="Face" Stretch="UniformToFill" />
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock x:Name="FaceName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                <TextBlock x:Name="FaceSource" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="360" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="No" Style="{StaticResource DangerButton}" IsCancel="True" />
            <Button Content="Yes" Style="{StaticResource PrimaryButton}" Foreground="White" IsDefault="True" Margin="8,0,0,0" Click="Yes" />
        </StackPanel>
    </StackPanel>
</Window>
