<Window x:Class="NpcAppearanceManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NpcAppearanceManager.App.ViewModels"
        xmlns:views="clr-namespace:NpcAppearanceManager.App.Views"
        Title="NPC Appearance Manager" Icon="NAM.ico" Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:NpcChooserViewModel}"><views:NpcChooserView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FaceCopyViewModel}"><views:FaceCopyView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BuildViewModel}"><views:BuildView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>

        <Style x:Key="StepButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="4" Padding="14,6" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <RadioButton DockPanel.Dock="Right" Style="{StaticResource StepButton}" Content="Settings"
                             Command="{Binding GoToSettingsCommand}" IsChecked="{Binding CurrentStep, Mode=OneWay, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Settings}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource StepButton}" Content="1  Pick faces"
                                 Command="{Binding GoToNpcsCommand}" IsEnabled="{Binding Chooser, Converter={x:Static views:NotNull.Instance}}"
                                 IsChecked="{Binding CurrentStep, Mode=OneWay, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Npcs}" />
                    <RadioButton Style="{StaticResource StepButton}" Content="2  Copy faces"
                                 Command="{Binding GoToCopyCommand}" IsEnabled="{Binding CopyFaces, Converter={x:Static views:NotNull.Instance}}"
                                 IsChecked="{Binding CurrentStep, Mode=OneWay, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Copy}" />
                    <RadioButton Style="{StaticResource StepButton}" Content="3  Build"
                                 Command="{Binding GoToBuildCommand}" IsEnabled="{Binding Build, Converter={x:Static views:NotNull.Instance}}"
                                 IsChecked="{Binding CurrentStep, Mode=OneWay, Converter={x:Static views:EnumMatch.Instance}, ConverterParameter=Build}" />
                    <TextBlock Text="{Binding SetupDescription}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="16" />

        <!-- Busy overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#AA000000" Visibility="{Binding BusyMessage, Converter={StaticResource NullToCollapsed}}">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="28,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
                <StackPanel>
                    <TextBlock Text="{Binding BusyMessage}" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
