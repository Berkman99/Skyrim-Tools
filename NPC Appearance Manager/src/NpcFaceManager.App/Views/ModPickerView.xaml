<UserControl x:Class="NpcFaceManager.App.Views.ModPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NpcFaceManager.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Pick overhauls" Style="{StaticResource Title}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,12,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox Content="Only mods with facegen" IsChecked="{Binding OnlyFaceMods}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <CheckBox Content="Show disabled mods" IsChecked="{Binding ShowDisabledMods}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Content="Untick all" Command="{Binding ClearAllCommand}" />
                <Button Content="Rescan" Command="{Binding RescanCommand}" />
            </StackPanel>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxWidth="360" HorizontalAlignment="Left" MinWidth="260"
                     Tag="Search mods or plugins..." />
        </DockPanel>

        <ListBox Grid.Row="2" ItemsSource="{Binding View}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.Resources>
                <!-- MO2 separator: click to fold its mods. -->
                <DataTemplate DataType="{x:Type vm:SeparatorRowViewModel}">
                    <Border Background="Transparent" Cursor="Hand" Padding="0,4,0,2">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}" />
                        </Border.InputBindings>
                        <DockPanel>
                            <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                  VerticalAlignment="Center" Margin="2,0,10,0" Width="8" />
                            <Border DockPanel.Dock="Right" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                            <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 4 4 L 0 8" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:ModRowViewModel}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsTicked}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ModName" Text="{Binding Name}" FontWeight="SemiBold" />
                                    <Border x:Name="BadgeBox" Style="{StaticResource Tag}" ToolTip="{Binding BadgeToolTip}"
                                            Visibility="{Binding Badge, Converter={StaticResource NullToCollapsed}}">
                                        <TextBlock Text="{Binding Badge}" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" FontStyle="Italic" />
                                </StackPanel>
                                <TextBlock Text="{Binding PluginsText}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           ToolTip="{Binding PluginsText}" Visibility="{Binding PluginsText, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Dependencies of a ticked mod: same ticks as in the main list. -->
                        <ItemsControl ItemsSource="{Binding Dependencies}" Margin="26,4,0,2"
                                      Visibility="{Binding ShowDependencies, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Row.IsTicked}" Margin="0,2" ToolTip="{Binding ToolTip}">
                                        <TextBlock x:Name="DepName" Text="{Binding Row.Name}" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                    </CheckBox>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding TooManyMasters}" Value="True">
                                            <Setter TargetName="DepName" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDisabledInMo2}" Value="True">
                            <Setter TargetName="ModName" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="FacesOnly">
                            <Setter TargetName="BadgeBox" Property="Background" Value="{StaticResource TagFacesOnlyBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding LoadSelectedCommand}" Padding="18,7">
                <TextBlock Foreground="{StaticResource OnAccentBrush}">
                    <Run Text="Load" /> <Run Text="{Binding TickedCount, Mode=OneWay}" /> <Run Text="mods" />
                </TextBlock>
            </Button>
            <CheckBox Content="Merge dependencies" IsChecked="{Binding MergeDependents}" VerticalAlignment="Center"
                      ToolTip="Mods that need a ticked mod are listed under it and ticked too, so everything can be switched off together. Red ones have too many masters and aren't ticked automatically." />
        </DockPanel>
    </Grid>
</UserControl>
