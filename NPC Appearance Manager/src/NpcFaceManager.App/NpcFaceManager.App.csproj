<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>NpcFaceManager.App</RootNamespace>
    <AssemblyName>NPC Appearance Manager</AssemblyName>
    <!-- MO2 hooks launched programs (USVFS). With Windows' CET shadow stack enabled the process crashes at
         start-up under MO2, so the exe is marked as not CET-compatible (same fix NPC2 uses). -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF projects don't get System.IO as an implicit using. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NpcFaceManager.Core\NpcFaceManager.Core.csproj" />
  </ItemGroup>

  <!-- Internal renderer: NPC Plugin Chooser 2's offscreen 3D renderer (CharacterViewer.Rendering). It isn't
       published on nuget.org, so it's taken from an installed copy of NPC2 together with the libraries it
       needs. Point Npc2Folder at another install with: dotnet build -p:Npc2Folder="C:\path\to\NPC2".
       Without it the app still builds; the "Internal renderer" option just shows as unavailable. -->
  <PropertyGroup>
    <Npc2Folder Condition="'$(Npc2Folder)' == ''">D:\Other\Gaming\Modding\Tools\NPC Plugin Chooser</Npc2Folder>
    <HasInternalRenderer Condition="Exists('$(Npc2Folder)\CharacterViewer.Rendering.dll')">true</HasInternalRenderer>
    <DefineConstants Condition="'$(HasInternalRenderer)' == 'true'">$(DefineConstants);INTERNAL_RENDERER</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(HasInternalRenderer)' == 'true'">
    <Reference Include="CharacterViewer.Rendering"><HintPath>$(Npc2Folder)\CharacterViewer.Rendering.dll</HintPath></Reference>
    <Reference Include="OpenTK.Core"><HintPath>$(Npc2Folder)\OpenTK.Core.dll</HintPath></Reference>
    <Reference Include="OpenTK.Mathematics"><HintPath>$(Npc2Folder)\OpenTK.Mathematics.dll</HintPath></Reference>
    <Reference Include="OpenTK.Graphics"><HintPath>$(Npc2Folder)\OpenTK.Graphics.dll</HintPath></Reference>
    <Reference Include="OpenTK.Windowing.Common"><HintPath>$(Npc2Folder)\OpenTK.Windowing.Common.dll</HintPath></Reference>
    <Reference Include="OpenTK.Windowing.Desktop"><HintPath>$(Npc2Folder)\OpenTK.Windowing.Desktop.dll</HintPath></Reference>
    <Reference Include="OpenTK.Windowing.GraphicsLibraryFramework"><HintPath>$(Npc2Folder)\OpenTK.Windowing.GraphicsLibraryFramework.dll</HintPath></Reference>
    <Reference Include="OpenTK.Input"><HintPath>$(Npc2Folder)\OpenTK.Input.dll</HintPath></Reference>
    <Reference Include="OpenTK.Compute"><HintPath>$(Npc2Folder)\OpenTK.Compute.dll</HintPath></Reference>
    <Reference Include="Pfim"><HintPath>$(Npc2Folder)\Pfim.dll</HintPath></Reference>
    <Reference Include="ReactiveUI"><HintPath>$(Npc2Folder)\ReactiveUI.dll</HintPath></Reference>
    <Reference Include="ReactiveUI.Wpf"><HintPath>$(Npc2Folder)\ReactiveUI.Wpf.dll</HintPath></Reference>
    <Reference Include="System.Reactive"><HintPath>$(Npc2Folder)\System.Reactive.dll</HintPath></Reference>
    <Reference Include="DynamicData"><HintPath>$(Npc2Folder)\DynamicData.dll</HintPath></Reference>
    <Reference Include="Splat"><HintPath>$(Npc2Folder)\Splat.dll</HintPath></Reference>
    <Reference Include="Splat.Core"><HintPath>$(Npc2Folder)\Splat.Core.dll</HintPath></Reference>
    <Reference Include="Splat.Logging"><HintPath>$(Npc2Folder)\Splat.Logging.dll</HintPath></Reference>
    <Reference Include="Splat.Builder"><HintPath>$(Npc2Folder)\Splat.Builder.dll</HintPath></Reference>
    <Reference Include="SixLabors.ImageSharp"><HintPath>$(Npc2Folder)\SixLabors.ImageSharp.dll</HintPath></Reference>
    <None Include="$(Npc2Folder)\runtimes\win-x64\native\glfw3.dll" Condition="Exists('$(Npc2Folder)\runtimes\win-x64\native\glfw3.dll')"
          Link="runtimes\win-x64\native\glfw3.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(Npc2Folder)\runtimes\win-x64\native\glfw3.dll" Condition="Exists('$(Npc2Folder)\runtimes\win-x64\native\glfw3.dll')"
          Link="glfw3.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(Npc2Folder)\Shaders\**\*" Link="Shaders\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
